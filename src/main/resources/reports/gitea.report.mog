{
    "name": "Gitea Report",
    "type": "xlsx",
    "filename": "${MOG_HOME}/Gitea_Report_${timestamp}.xlsx",
    "styles": [
        {
            "type": "table",
            "name": "TableStyleLight12",
            "showFirstColumn": false,
            "showLastColumn": false,
            "showRowStripes": true,
            "showColumnStripes": true
        },
        {
            "type": "cell",
            "name": "TopWrap",
            "wrapText": true,
            "verticalAlginment": "top"
        }
    ],
    "dataSources": [
        {
            "name": "cnvtools",
            "type": "api",
            "url": "https://cnvtools.com/gitea/api/v1",
            "token": "75f49e4bf78c344ce432327884446578060c1000"
}
    ],
    "sheets": [
        {
            "name": "information",
            "title": "Information",
            "elements": [
                {
                    "type": "spannedText",
                    "upperLeft": {
                        "row": 0,
                        "col": 0
                    },
                    "lowerRight": {
                        "row": 0,
                        "col": 3
                    },
                    "height": 100,
                    "text": "Copyright © 2022 Gainwell Technologies\n\nReport ID: 5010 - Conversion Cycle\n\nPurpose: The purpose of this report is to provide a single source by which leadership can assess the overall performance of the conversion upon the completion of a conversion cycle.",
                    "style": "TopWrap"
                },
                {
                    "type": "table",
                    "name": "changeLog",
                    "title": "ChangeLog",
                    "style": "TableStyleLight12",
                    "upperLeft": {
                        "row": 2,
                        "col": 0
                    },
                    "columns": [
                        {
                            "title": "Date",
                            "key": "created_at",
                            "width": 31
                        },
                        {
                            "title": "Issue",
                            "key": "title",
                            "width": 150
                        },
                        {
                            "title": "Assignee",
                            "key": "assignee.full_name",
                            "width": 21
                        },
                        {
                            "title": "Project",
                            "key": "repository.name",
                            "width": 21
                        },
                        {
                            "title": "Status",
                            "key": "state",
                            "width": 21
                        }
                    ],
                    "dataSource": {
                        "name": "cnvtools",
                        "filter": {
                            "type": "json",
                            "suburl": "/repos/issues/search",
                            "method": "GET",
                            "jsonPath": "$.[*]"
                        }
                    }
                }
            ]
        }
    ]
}