{
    "name": "Conversion Cycle Summary",
    "type": "xlsx",
    "filename": "${MOG_HOME}/Conversion_Cycle_Summary_${timestamp}.xlsx",
    "styles": [
        {
            "type": "table",
            "name": "TableStyleLight12",
            "showFirstColumn": false,
            "showLastColumn": false,
            "showRowStripes": true,
            "showColumnStripes": true
        },
        {
            "type": "cell",
            "name": "TopWrap",
            "wrapText": true,
            "verticalAlginment": "top"
        }
    ],
    "sheets": [
        {
            "name": "information",
            "title": "Information",
            "elements": [
                {
                    "type": "spannedText",
                    "upperLeft": {
                        "row": 0,
                        "col": 0
                    },
                    "lowerRight": {
                        "row": 0,
                        "col": 3
                    },
                    "height": 100,
                    "text": "Copyright © 2022 Gainwell Technologies\n\nReport ID: 5010 - Conversion Cycle\n\nPurpose: The purpose of this report is to provide a single source by which leadership can assess the overall performance of the conversion upon the completion of a conversion cycle.",
                    "style": "TopWrap"
                },
                {
                    "type": "table",
                    "name": "changeLog",
                    "title": "ChangeLog",
                    "style": "TableStyleLight12",
                    "upperLeft": {
                        "row": 2,
                        "col": 0
                    },
                    "columns": [
                        {
                            "title": "Date",
                            "key": "change_date",
                            "width": 31
                        },
                        {
                            "title": "Name",
                            "key": "change_user",
                            "width": 21
                        },
                        {
                            "title": "Ver",
                            "key": "change_version",
                            "width": 21
                        },
                        {
                            "title": "Change",
                            "key": "change_text",
                            "width": 75
                        }
                    ],
                    "dataSource": {
                        "type": "jdbc",
                        "url": "jdbc:h2:file:${MOG_HOME}/reporting.db",
                        "user": "h2",
                        "password": "U2FsdGVkX1+XQQ8FdUfEPdFfn5Jsgkvxet9PKkEwOXg=",
                        "query": "select * from t_ccr_changelog order by change_date desc",
                        "jdbcClass": "org.h2.Driver"
                    }
                }
            ]
        },
        {
            "name": "cc_summary",
            "title": "Conversion Cycle Summary",
            "elements": [
                {
                    "type": "spannedText",
                    "upperLeft": {
                        "row": 0,
                        "col": 0
                    },
                    "lowerRight": {
                        "row": 0,
                        "col": 3
                    },
                    "height": 50,
                    "text": "Copyright © 2022 Gainwell Technologies\n\nThis tab contains the conversion cycle summary information.",
                    "style": "TopWrap"
                },
                {
                    "type": "table",
                    "name": "summaryReport",
                    "title": "SummaryReport",
                    "style": "TableStyleLight12",
                    "upperLeft": {
                        "row": 2,
                        "col": 0
                    },
                    "columns": [
                        {
                            "title": "RUN ID",
                            "key": "run_id",
                            "width": 31
                        },
                        {
                            "title": "Run Date",
                            "key": "date_run",
                            "width": 31
                        },
                        {
                            "title": "Cycle Duration",
                            "key": "duration",
                            "width": 31
                        },
                        {
                            "title": "Source Date",
                            "key": "source_date",
                            "width": 50
                        },
                        {
                            "title": "Target Database",
                            "key": "target_database",
                            "width": 31
                        },
                        {
                            "title": "Source Record Count",
                            "key": "source_record_count",
                            "width": 31
                        },
                        {
                            "title": "Bypassed Record Count",
                            "key": "bypassed_record_count",
                            "width": 31
                        },
                        {
                            "title": "Orphan Record Count",
                            "key": "orphan_record_count",
                            "width": 31
                        },
                        {
                            "title": "Source Records Considered Count",
                            "key": "considered_record_count",
                            "width": 31
                        },
                        {
                            "title": "Source Records Error Count",
                            "key": "source_errors_count",
                            "width": 31
                        },
                        {
                            "title": "Source Records Converted Count",
                            "key": "converted_record_count",
                            "width": 31
                        },
                        {
                            "title": "Source Records Converted Percent",
                            "key": "converted_record_percent",
                            "width": 31
                        },
                        {
                            "title": "Target Record Count",
                            "key": "target_record_count",
                            "width": 31
                        },
                        {
                            "title": "Error Record Count",
                            "key": "error_record_count",
                            "width": 31
                        },
                        {
                            "title": "Warning Record Count",
                            "key": "warning_record_count",
                            "width": 31
                        },
                        {
                            "title": "Informational Record Count",
                            "key": "info_record_count",
                            "width": 31
                        }
                    ]
                }
            ]
        },
        {
            "name": "src_summary",
