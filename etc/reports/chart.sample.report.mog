{
  "name": "chart-sample",
  "type": "xlsx",
  "filename": "chart-sample-${timestamp}.xlsx",
  "dataSources": [
    { "name": "inline", "type": "json", "file": "src/main/examples/reports/sales.json" }
  ],
  "sheets": [
    {
      "name": "Charting",
      "title": "Charting",
      "elements": [
        {
          "type": "table",
          "name": "t_sales",
          "title": "Sales",
          "upperLeft": { "row": 1, "col": 1 },
          "columns": [
            { "title": "Region", "key": "region" },
            { "title": "Revenue", "key": "revenue" },
            { "title": "Units", "key": "units" }
          ],
          "dataSource": { "name": "inline", "filter": { "type": "json", "jsonPath": "$.data" } }
        },
        {
          "type": "chart",
          "name": "sales_chart",
          "chartType": "bar",
          "title": "Revenue by Region",
          "upperLeft": { "row": 1, "col": 8 },
          "width": 10, "height": 16,
          "category": { "table": "t_sales", "column": 0 },
          "series": [
            { "name": "Revenue", "table": "t_sales", "column": 1 }
          ]
        }
      ]
    }
  ]
}
